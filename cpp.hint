#define REGISTER_MANAGER_TYPE(ManagerClassName, ManagerNameString) namespace { class Manager##ManagerClassName##Registrar { public: Manager##ManagerClassName##Registrar() { ServiceLocator::RegisterServiceCreator( ManagerNameString, []() { return std::make_shared<ManagerClassName>(); }, [](std::shared_ptr<void> rawService, const YAML::Node& configNode, HWND hwnd, int width, int height) { if (auto windowDependent = std::dynamic_pointer_cast<IWindowDependentInitializable>(rawService)) { return windowDependent->Init(configNode, hwnd, width, height); } if (auto simpleInitializable = std::dynamic_pointer_cast<IInitializable>(rawService)) { return simpleInitializable->Init(configNode); } OutputDebugStringA(("ERROR: Manager '" ManagerNameString "' no implementa una interfaz de inicialización válida.\n")); return E_FAIL; } ); } }; static Manager##ManagerClassName##Registrar s_register_##ManagerClassName; }
#define S_OK ((HRESULT)0L)
#define E_FAIL _HRESULT_TYPEDEF_(0x80004005L)
#define E_FAIL _HRESULT_TYPEDEF_(0x80000008L)
#define REGISTER_SERVICE_TYPE(ServiceClassName, ServiceNameString) namespace { class Service##ServiceClassName##Registrar { public: Service##ServiceClassName##Registrar() { ServiceLocator::RegisterServiceCreator( ServiceNameString, []() -> std::shared_ptr<IService> { return std::make_shared<ServiceClassName>(); }, DEFINE_INIT_SERVICE_LAMBDA(ServiceNameString), DEFINE_RENDER_SERVICE_LAMBDA(ServiceNameString), DEFINE_UPDATE_SERVICE_LAMBDA(ServiceNameString) ); } }; static Service##ServiceClassName##Registrar s_register_##ServiceClassName; }
